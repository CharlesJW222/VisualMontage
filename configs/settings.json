{
  "dataset": {
    "data_root": "Video_Dataset_Categories",
    "default_dataset": "01_Emergency_and_Disaster_Response/air_ground_firefighting"
  },
  "llm": {
    "private_api": {
      "base_url": "https://your-private-api.example/v1",
      "endpoint_path": "chat/completions",
      "api_key_env": "PRIVATE_API_KEY",
      "timeout_seconds": 300,
      "connect_timeout_seconds": 20,
      "max_retries": 4,
      "verify_ssl": true
    },
    "roles": {
      "screenwriter": {
        "model": "gpt-5.6-luna",
        "temperature": 0.7,
        "max_tokens": 2500
      },
      "visual_editor": {
        "model": "gpt-5.6-luna",
        "temperature": 0.7,
        "max_tokens": 2200
      },
      "caption_editor": {
        "model": "gpt-5.6-luna",
        "temperature": 0.3,
        "max_tokens": 2200
      },
      "director": {
        "model": "gpt-5.6-luna",
        "temperature": 0.1,
        "max_tokens": 1800
      },
      "victim": {
        "model": "gpt-5.5",
        "temperature": 0.7,
        "max_tokens": 3000
      },
      "judge": {
        "model": "gpt-5.5",
        "temperature": 0.1,
        "max_tokens": 2200
      }
    }
  },
  "victim_validation": {
    "num_victims": 5,
    "num_conclusions": 1,
    "ground_truth": "false",
    "high_confidence_threshold": 0.8
  },
  "output": {
    "directory": "attack_plan",
    "materialize_captioned_images": true
  },
  "production": {
    "min_output_frames": 5,
    "max_output_frames": 30
  }
}
